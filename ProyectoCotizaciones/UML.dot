digraph UML { graph [rankdir=BT,bgcolor=white,pad=.25]; node [shape=record,fontname="Helvetica",fontsize=11]; edge [fontname="Helvetica",fontsize=10];
Cotizacion [label="{Cotizacion|- idCotizacion: int\l- numCotizacion: String\l- descripcion: String\l- porcentaje: float\l- precio: float\l- plazos: int\l- fecha: Date\l- status: int\l|+ Cotizacion()\l+ Cotizacion(datos)\l+ getters y setters\l+ calcularPagoInicial(): float\l+ calcularTotalFin(): float\l+ calcularPagoMensual(): float\l}"];
 dbMetodos [label="{«interface» dbMetodos|+ abrir(): boolean\l+ cerrar(): boolean\l+ insertar(Object): int\l+ actualizar(Object): int\l+ habilitar(int): int\l+ deshabilitar(int): int\l+ buscarId(int): Object\l+ buscarActivos(): ResultSet\l+ buscarNoActivos(): ResultSet\l+ borrar(int): int\l+ buscar(String): Object\l}"];
 CotizacionDb [label="{CotizacionDb|- MYSQLURL: String\l- usuario: String\l- password: String\l- conexion: Connection\l- error: String\l|+ CotizacionDb()\l+ getError(): String\l+ operaciones de dbMetodos\l}"];
 jdlCotizacion [label="{jdlCotizacion|- cotizacion: Cotizacion\l- db: CotizacionDb\l- controles Swing y JDateChooser\l|+ jdlCotizacion()\l+ limpiar(): void\l+ habilitar(): void\l+ deshabilitar(): void\l+ validar(): boolean\l+ llenarObjeto(): Cotizacion\l+ mostrarDatos(Cotizacion): void\l+ mostrarMensaje(String): void\l}"];
 CotizacionDb -> dbMetodos [style=dashed,arrowhead=empty]; jdlCotizacion -> Cotizacion [dir=both,arrowtail=diamond,arrowhead=none]; jdlCotizacion -> CotizacionDb [dir=both,arrowtail=diamond,arrowhead=none]; CotizacionDb -> Cotizacion [style=dashed,arrowhead=open]; }
